{
  "name": "tender-monitor",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test && vitest run --config vitest.scripts.config.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "format": "prettier --write .",
    "e2e": "tsx scripts/e2e.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "4.23.15",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "~2.1.9"
  }
}
