{
  "$ref": "#/definitions/search-config",
  "definitions": {
    "search-config": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "motorbikes",
                  "riding_gear",
                  "ppe"
                ]
              },
              "label": {
                "type": "string"
              },
              "terms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "requireContext": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": [
              "id",
              "label",
              "terms"
            ],
            "additionalProperties": false
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "publishedSince": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "groups"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
